<style>
/* Layout: alternating bands — light hero with paper-trail timeline, yellow stat band, model diagram, crew dot-grid, Likert bars, dark quote, recommendation tiles. */
:root{
  --bg:#f5f6f2; --surface:#ffffff; --fg:#1b2127; --muted:#5b6670; --line:#dde1dc;
  --accent:#efb710; --accent-ink:#1b2127; --blue:#1e7fc0; --blue-soft:#e2eff8;
  --ink:#16202a; --ink-fg:#eef1ec;
  --l1:#c9563f; --l2:#e08e5a; --l3:#b9c0c4; --l4:#5aa7d8; --l5:#1e6fa8;
  --display:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;
  --body:"Source Serif 4",Georgia,"Times New Roman",serif;
  --mono:"JetBrains Mono",ui-monospace,Menlo,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#11161b; --surface:#1a2128; --fg:#e8ebe7; --muted:#9aa5ae; --line:#2b343c;
  --accent:#f2c230; --accent-ink:#11161b; --blue:#5cb2ea; --blue-soft:#163042;
  --ink:#0b0f13; --ink-fg:#eef1ec;
  --l1:#e0715b; --l2:#eba277; --l3:#55606a; --l4:#5aa7d8; --l5:#8fcaf2; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#11161b; --surface:#1a2128; --fg:#e8ebe7; --muted:#9aa5ae; --line:#2b343c;
  --accent:#f2c230; --accent-ink:#11161b; --blue:#5cb2ea; --blue-soft:#163042;
  --ink:#0b0f13; --ink-fg:#eef1ec;
  --l1:#e0715b; --l2:#eba277; --l3:#55606a; --l4:#5aa7d8; --l5:#8fcaf2; color-scheme:dark}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:17px;line-height:1.65;transition:background .25s,color .25s}
.wrap{max-width:1100px;margin:0 auto;padding-left:max(20px,env(safe-area-inset-left,0px));padding-right:max(20px,env(safe-area-inset-right,0px))}
a{color:var(--blue)}
h1,h2,h3{font-family:var(--display);line-height:1.1;text-wrap:balance;margin:0}
p{margin:0 0 14px}
.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:flex;align-items:center;gap:10px}
.eyebrow::before{content:"";width:22px;height:3px;background:var(--accent);border-radius:2px}
section{padding-block:72px;scroll-margin-top:60px}
section h2{font-size:clamp(28px,4vw,44px);font-weight:800;letter-spacing:-.02em;margin:12px 0 18px}
.lead{font-size:19px;max-width:60ch}

/* bar */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:9;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.bar .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:10px}
.brand{font-family:var(--display);font-weight:800;font-size:15px;display:flex;align-items:center;gap:8px;min-width:0;white-space:nowrap}
.brand .dot{width:22px;height:22px;border-radius:5px;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;font-size:11px;flex:none}
.nav{display:flex;gap:4px}
.nav a{font:600 13px var(--display);color:var(--muted);text-decoration:none;padding:6px 10px;border-radius:999px}
.nav a:hover{background:var(--surface);color:var(--fg)}
.controls{display:flex;gap:8px;flex:none}
.seg{display:flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:var(--surface)}
.seg button{font:600 12px var(--mono);border:0;background:transparent;color:var(--muted);padding:7px 11px;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--fg);color:var(--bg)}
.icon-btn{border:1px solid var(--line);background:var(--surface);color:var(--fg);border-radius:999px;width:34px;height:34px;display:grid;place-items:center;cursor:pointer}
button:focus-visible,a:focus-visible{outline:2px solid var(--blue);outline-offset:2px}

/* hero */
.hero{position:relative;overflow:hidden;padding-block:56px 0}
.hero::after{content:"";position:absolute;inset:0;background-image:radial-gradient(var(--line) 1px,transparent 1px);background-size:22px 22px;mask-image:linear-gradient(to bottom,#000 0%,transparent 85%);-webkit-mask-image:linear-gradient(to bottom,#000 0%,transparent 85%);pointer-events:none;z-index:0}
.hero .wrap{position:relative;z-index:1}
.hero-grid{display:grid;grid-template-columns:1fr 300px;gap:56px;align-items:start}
.hero-grid>*{min-width:0}
.tagrow{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:22px}
.tag{font:600 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;padding:6px 10px;border-radius:4px;background:var(--fg);color:var(--bg)}
.tag.y{background:var(--accent);color:var(--accent-ink)}
.hero h1{font-size:clamp(28px,4vw,46px);font-weight:800;letter-spacing:-.02em;line-height:1.15}
.hero h1 em{font-style:normal;color:var(--accent-ink);background:var(--accent);padding:0 .15em;border-radius:6px;box-decoration-break:clone;-webkit-box-decoration-break:clone}
:root[data-theme="dark"] .hero h1 em{color:var(--accent-ink)}
.sub{font-style:italic;color:var(--muted);margin:18px 0 24px;font-size:20px;max-width:46ch}
.authors{display:flex;flex-wrap:wrap;gap:10px}
.author{display:flex;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:5px 14px 5px 5px}
.author .av{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font:700 12px var(--display);background:var(--blue);color:#fff}
.author .av.y{background:var(--accent);color:var(--accent-ink)}
.author b{font-family:var(--display);font-size:15px}
.author small{display:block;font:400 11px var(--mono);color:var(--muted);line-height:1.2}
.cta{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}
.btn{font:700 15px var(--display);text-decoration:none;padding:13px 20px;border-radius:12px;display:inline-flex;align-items:center;gap:8px;border:1.5px solid var(--fg);color:var(--fg);cursor:pointer;background:transparent;transition:transform .15s}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);box-shadow:0 6px 0 -1px color-mix(in srgb,var(--accent) 45%,#000)}
.btn:hover{transform:translateY(-2px)}
.photo{margin:0;position:relative}
.photo .frame{position:relative;transform:rotate(2deg);background:var(--surface);padding:10px 10px 46px;border-radius:6px;box-shadow:0 18px 40px -20px rgba(0,0,0,.45)}
.photo img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:35% 30%;border-radius:3px}
.photo .handwrite{position:absolute;left:14px;right:14px;bottom:12px;font:600 14px var(--display);color:var(--fg);display:flex;justify-content:space-between;gap:8px}
.photo .handwrite span{font:400 11px var(--mono);color:var(--muted);align-self:center}
.photo .tape{position:absolute;top:-10px;left:50%;width:84px;height:22px;transform:translateX(-50%) rotate(-4deg);background:color-mix(in srgb,var(--accent) 70%,transparent)}
.photo figcaption{margin-top:18px;font-size:14px;color:var(--muted);line-height:1.4;text-align:center}

/* timeline */
.trail{margin-top:56px;border-top:1px solid var(--line);padding-block:22px 30px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;position:relative}
.trail div{position:relative;padding-top:16px}
.trail div::before{content:"";position:absolute;top:-28px;left:0;width:11px;height:11px;border-radius:50%;background:var(--bg);border:3px solid var(--blue)}
.trail div:last-child::before{background:var(--accent);border-color:var(--accent)}
.trail .k{font:600 11px var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.trail .v{font:700 16px var(--display);font-variant-numeric:tabular-nums}

/* stats band */
.band-y{background:var(--accent);color:var(--accent-ink)}
.band-y .eyebrow{color:var(--accent-ink);opacity:.75}
.band-y .eyebrow::before{background:var(--accent-ink)}
.stats-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:end}
.stats-grid>*{min-width:0}
.big{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:2px solid var(--accent-ink)}
.big div{padding:18px 16px 4px 0}
.big div+div{border-left:2px solid var(--accent-ink);padding-left:16px}
.big .n{font:800 clamp(46px,7vw,80px)/1 var(--display);letter-spacing:-.04em;font-variant-numeric:tabular-nums}
.big .l{font:700 14px var(--display);margin-top:8px}
.big .d{font:400 12px var(--mono);opacity:.75}
.band-y p{font-size:18px}

/* model */
.model{display:grid;grid-template-columns:1fr auto 1fr;gap:0;align-items:center;margin-top:34px}
.node{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:20px 22px}
.node .kind{font:600 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--blue)}
.node h3{font-size:22px;font-weight:800;margin:4px 0 8px}
.node ul{margin:0;padding:0;list-style:none;display:flex;flex-wrap:wrap;gap:6px}
.node li{font:400 12.5px var(--mono);background:var(--bg);border-radius:6px;padding:3px 8px;color:var(--muted)}
.node.x{border:2px solid var(--fg);box-shadow:6px 6px 0 var(--accent)}
.outs{display:flex;flex-direction:column;gap:18px}
.links{display:flex;flex-direction:column;gap:70px;padding-inline:8px;min-width:150px}
.link{position:relative;text-align:center}
.link .r{font:700 22px var(--mono);font-variant-numeric:tabular-nums;background:var(--bg);position:relative;z-index:1;padding:0 6px;display:inline-block}
.link .s{font:400 11px var(--mono);color:var(--muted);display:block}
.link::before{content:"";position:absolute;left:0;right:10px;top:16px;border-top:2.5px dashed var(--blue)}
.link::after{content:"";position:absolute;right:0;top:10px;border-left:12px solid var(--blue);border-top:7px solid transparent;border-bottom:7px solid transparent}
.model-note{font:400 13px var(--mono);color:var(--muted);margin-top:18px}

/* crew */
.band-s{background:var(--surface);border-block:1px solid var(--line)}
.crew-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:56px;align-items:center}
.crew-grid>*{min-width:0}
.dots{display:grid;grid-template-columns:repeat(8,1fr);gap:10px;max-width:420px}
.dots svg{width:100%;height:auto}
.key{display:flex;flex-direction:column;gap:12px;margin-top:22px}
.key div{display:flex;align-items:baseline;gap:12px}
.key i{width:12px;height:12px;border-radius:50%;flex:none;align-self:center}
.key b{font:800 28px var(--display);width:44px;font-variant-numeric:tabular-nums}
.key span{font-family:var(--display);font-weight:500}

/* likert */
.lk-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:56px}
.lk-grid>*{min-width:0}
.likert{display:flex;flex-direction:column;gap:24px}
.lrow .head{display:flex;justify-content:space-between;gap:10px;font-family:var(--display);font-weight:700;margin-bottom:8px;flex-wrap:wrap}
.lrow .head span{font:400 13px var(--mono);color:var(--muted)}
.stack{display:flex;height:36px;border-radius:8px;overflow:hidden}
.stack i{display:block;height:100%;position:relative}
.stack i b{position:absolute;inset:0;display:grid;place-items:center;font:600 11px var(--mono);color:#fff}
.legend{display:flex;flex-wrap:wrap;gap:8px 16px;font:400 12.5px var(--mono);color:var(--muted);margin-top:4px}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:10px;height:10px;border-radius:2px;display:inline-block}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.chip{font:600 12.5px var(--mono);background:var(--blue-soft);color:var(--fg);padding:6px 10px;border-radius:6px}

/* quote */
.quote{background:var(--ink);color:var(--ink-fg);position:relative;overflow:hidden}
.quote .eyebrow{color:var(--ink-fg);opacity:.7}
.quote-grid{display:grid;grid-template-columns:auto 1fr;gap:36px;align-items:start;margin-top:24px}
.quote .mark{font:800 160px/0.8 var(--display);color:var(--accent)}
.quote blockquote{margin:0;font-family:var(--display);font-weight:700;font-size:clamp(24px,3.6vw,40px);line-height:1.18;letter-spacing:-.01em;text-wrap:balance}
.quote .who{margin-top:22px;display:flex;gap:12px;align-items:center;font-size:15px}
.quote .who .av{width:38px;height:38px;border-radius:50%;background:var(--accent);color:#16202a;display:grid;place-items:center;font:800 14px var(--display)}
.quote .who small{display:block;opacity:.7;font:400 12px var(--mono)}
.quote p.ctx{margin-top:22px;opacity:.8;max-width:62ch}

/* recs */
.recs{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:30px}
.rec{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px;display:flex;gap:16px}
.rec .ic{width:44px;height:44px;border-radius:12px;background:var(--blue-soft);color:var(--blue);display:grid;place-items:center;flex:none}
.rec h3{font-size:18px;font-weight:700;margin-bottom:4px}
.rec p{color:var(--muted);font-size:15px;margin:0}
.rec:first-child{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.rec:first-child p{color:inherit;opacity:.75}
.rec:first-child .ic{background:var(--accent);color:var(--accent-ink)}

/* cite */
.cite-box{margin-top:48px;display:grid;grid-template-columns:1.3fr 1fr;gap:24px;align-items:center;border:2px dashed var(--line);border-radius:18px;padding:24px}
.cite-box>*{min-width:0}
.cite{font-size:15.5px}
.cite-actions{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end}
.kw{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.kw span{font:400 12px var(--mono);border:1px solid var(--line);border-radius:999px;padding:3px 10px;color:var(--muted)}
footer{border-top:1px solid var(--line);padding-block:26px;color:var(--muted);font-size:14px}
footer .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}

@media (max-width:900px){
  .nav{display:none}
  .hero-grid,.stats-grid,.crew-grid,.lk-grid,.cite-box{grid-template-columns:1fr;gap:32px}
  .photo{max-width:230px;order:-1;margin-inline:auto}
  .trail{grid-template-columns:repeat(2,1fr);row-gap:34px}
  .model{grid-template-columns:1fr;gap:0}
  .links{flex-direction:row;gap:12px;padding:18px 0;justify-content:space-around;min-width:0}
  .link{padding-top:30px}
  .link::before{left:50%;right:auto;top:0;height:28px;border-top:0;border-left:2.5px dashed var(--blue)}
  .link::after{left:calc(50% - 6px);right:auto;top:22px;border-left:7px solid transparent;border-right:7px solid transparent;border-top:12px solid var(--blue);border-bottom:0}
  .recs{grid-template-columns:1fr}
  .cite-actions{justify-content:flex-start}
  .quote-grid{grid-template-columns:1fr;gap:0}
  .quote .mark{font-size:100px;height:60px}
}
@media (max-width:480px){
  .big{grid-template-columns:1fr}
  .big div+div{border-left:0;border-top:2px solid var(--accent-ink);padding-left:0}
  .brand b{display:none}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}.btn:hover{transform:none}}
</style>

